  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Adam Fendley",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravitylow/ddb-token-bucket.git"
