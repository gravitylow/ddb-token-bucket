    "@shelf/jest-dynamodb": "^3.5.0",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
